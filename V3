local TouchJumpHeld = false
local TouchJumpInput = nil

-- phone: watch Roblox's on-screen jump button
task.spawn(function()
	local touchGui = PlayerGui:WaitForChild("TouchGui", 20)

	if not touchGui then
		return
	end

	local frame = touchGui:WaitForChild("TouchControlFrame", 10)
	local jumpButton = frame and frame:WaitForChild("JumpButton", 10)

	if not jumpButton then
		return
	end

	jumpButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			TouchJumpHeld = true
			TouchJumpInput = input
		end
	end)

	jumpButton.InputEnded:Connect(function(input)
		if input == TouchJumpInput then
			TouchJumpHeld = false
			TouchJumpInput = nil
		end
	end)
end)

-- finger lifted anywhere (even off the button): stop flying
UserInputService.InputEnded:Connect(function(input)
	if input == TouchJumpInput then
		TouchJumpHeld = false
		TouchJumpInput = nil
	end
end)

local function IsJumpHeld()
	return TouchJumpHeld
		or UserInputService:IsKeyDown(Enum.KeyCode.Space)
		or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA)
end

RunService.Stepped:Connect(function()
	if not Config.FlyJump or Spectating then
		return
	end

	if not IsJumpHeld() then
		return
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	-- keep your sideways movement, push upward while the button is held
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, Config.FlySpeed, velocity.Z)
end)

