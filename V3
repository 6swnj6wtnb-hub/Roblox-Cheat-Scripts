-- keeps the camera on the right player (respawns) and skips players who leave
task.spawn(function()
	while Gui.Parent do
		task.wait(0.2)

		if Spectating then
			if not SpectateTarget or not SpectateTarget.Parent then
				StepSpectate(1)
			else
				ApplySpectateSubject()
			end
		end
	end
end)

