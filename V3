local RGBObjects = {}

local function RegisterRGB(obj, property)
	table.insert(RGBObjects, {
		Object = obj,
		Property = property
	})
end

local RGBTime = 0

RunService.RenderStepped:Connect(function(dt)
	RGBTime += dt * Config.RGBSpeed

	local hue = RGBTime % 1
	local color = Color3.fromHSV(hue, 1, 1)

	for _, data in ipairs(RGBObjects) do
		if data.Object and data.Object.Parent then
			pcall(function()
				data.Object[data.Property] = color
			end)
		end
	end
end)

