------------------------------------------------------------
-- 2X SPEED (double speed, instantly, with an on/off button)
------------------------------------------------------------

local SpeedBase = nil     -- the game's normal speed (changes when the game makes you sprint, etc.)
local SpeedLastSet = nil  -- the last speed we set

-- runs on Stepped = right BEFORE the physics step, so the game can't change the
-- speed back in between (this is why it used to take a couple of seconds to kick in)
RunService.Stepped:Connect(function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		SpeedBase = nil
		SpeedLastSet = nil
		return
	end

	-- the speed is not what we set: the game changed it (sprint, new character...),
	-- so that is the new normal speed
	if SpeedLastSet == nil or math.abs(humanoid.WalkSpeed - SpeedLastSet) > 0.01 then
		SpeedBase = humanoid.WalkSpeed
	end

	local multiplier = Config.SpeedBoost and Config.SpeedMultiplier or 1

	-- never start from a slow, ramping-up game speed: the boost is always at least
	-- BaseSpeed x multiplier, so it is full speed the instant you start moving
	local target = SpeedBase

	if multiplier > 1.01 then
		target = math.max(Config.BaseSpeed, SpeedBase) * multiplier
	end

	if math.abs(humanoid.WalkSpeed - target) > 0.01 then
		humanoid.WalkSpeed = target
	end

	SpeedLastSet = humanoid.WalkSpeed

	-- backup that works even if the game ignores WalkSpeed: push your sideways
	-- velocity straight to the boosted speed while you are moving
	if multiplier > 1.01 and not Spectating then
		local root = character:FindFirstChild("HumanoidRootPart")
		local move = humanoid.MoveDirection

		if root and move.Magnitude > 0.05 then
			-- full speed straight away in the direction you are moving (no ramp-up)
			local direction = move.Unit
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(direction.X * target, velocity.Y, direction.Z * target)
		end
	end
end)

CreateButton("2X SPEED: ON", function(button)
	Config.SpeedBoost = not Config.SpeedBoost
	button.Text = "2X SPEED: " .. (Config.SpeedBoost and "ON" or "OFF")
end)

