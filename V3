local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "RGB_ESP"
ESPFolder.Parent = Gui

local ESPObjects = {}

local function RemoveESP(player)
	local data = ESPObjects[player]

	if data then
		if data.Billboard then
			data.Billboard:Destroy()
		end

		if data.Highlight then
			data.Highlight:Destroy()
		end

		if data.Glows then
			for _, glow in pairs(data.Glows) do
				glow:Destroy()
			end
		end

		ESPObjects[player] = nil
	end
end

------------------------------------------------------------
-- BODY PART GLOW (every body part glows RGB, R15 and R6, visible through walls)
------------------------------------------------------------

local R15Parts = {
	"Head",
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot"
}

local R6Parts = {
	"Head",
	"Torso",
	"Left Arm",
	"Right Arm",
	"Left Leg",
	"Right Leg"
}

local GlowTransparency = 0 -- 0 = fully solid, no see-through

local function CreateGlow(part)
	local glow = Instance.new("BoxHandleAdornment")
	glow.Name = "RGB_Glow"
	glow.Adornee = part
	glow.Size = part.Size + Vector3.new(0.06, 0.06, 0.06)
	glow.AlwaysOnTop = true
	glow.ZIndex = 5
	glow.Transparency = GlowTransparency
	glow.Parent = ESPFolder

	RegisterRGB(glow, "Color3")

	return glow
end

local function UpdateGlows(data, character)
	local names = character:FindFirstChild("UpperTorso") and R15Parts or R6Parts

	data.Glows = data.Glows or {}

	for _, name in ipairs(names) do
		local part = character:FindFirstChild(name)
		local glow = data.Glows[name]

		if part and part:IsA("BasePart") then
			-- (re)create when new, or when the part was replaced
			if not glow or glow.Adornee ~= part then
				if glow then
					glow:Destroy()
				end

				glow = CreateGlow(part)
				data.Glows[name] = glow
			end
		elseif glow then
			glow:Destroy()
			data.Glows[name] = nil
		end
	end
end

local function ClearGlows(data)
	if data.Glows then
		for _, glow in pairs(data.Glows) do
			glow:Destroy()
		end

		data.Glows = nil
	end
end

local function UpdateESP(player)
	if player == LocalPlayer then
		return
	end

	if not Config.ESP then
		RemoveESP(player)
		return
	end

	if IsTeammate(player) then
		RemoveESP(player)
		return
	end

	local character = GetCharacter(player)

	if not character then
		RemoveESP(player)
		return
	end

	local head = GetAimPart(character)

	if not head then
		return
	end

	local data = ESPObjects[player]

	if not data then
		data = {}

		if Config.ESPChams then
			local highlight = Instance.new("Highlight")
			highlight.Name = "RGB_Chams"
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.FillTransparency = 1
			highlight.OutlineTransparency = 0
			highlight.Parent = character

			RegisterRGB(highlight, "FillColor")
			RegisterRGB(highlight, "OutlineColor")

			data.Highlight = highlight
		end

		if Config.ESPNames then
			local billboard = Instance.new("BillboardGui")
			billboard.Name = "RGB_Info"
			billboard.Size = UDim2.fromOffset(140, 18)
			billboard.StudsOffset = Vector3.new(0, 2.6, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = head

			local label = Instance.new("TextLabel")
			label.Size = UDim2.fromScale(1, 1)
			label.BackgroundTransparency = 1
			label.TextScaled = false
			label.TextSize = 12
			label.Font = Enum.Font.GothamBold
			label.TextStrokeTransparency = 0.5
			label.Parent = billboard

			RegisterRGB(label, "TextColor3")

			data.Billboard = billboard
			data.Label = label
		end

		ESPObjects[player] = data
	end

	-- every body part glows RGB
	if Config.ESPChams then
		UpdateGlows(data, character)
	else
		ClearGlows(data)
	end

	if data.Label then
		local text = player.DisplayName

		if IsBypassed(player) then
			text = text .. " [BYPASSED]"
		end

		data.Label.Text = text
	end
end

