-- NO CLIP (walk through walls)
------------------------------------------------------------

local NoClipChanged = setmetatable({}, { __mode = "k" })

-- runs every physics step while no clip is on: turns collisions off on your character
RunService.Stepped:Connect(function()
	if not Config.NoClip then
		return
	end

	local character = LocalPlayer.Character

	if not character then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			NoClipChanged[part] = true
			part.CanCollide = false
		end
	end
end)

local function RestoreCollisions()
	for part in pairs(NoClipChanged) do
		if part.Parent then
			part.CanCollide = true
		end
	end

	table.clear(NoClipChanged)
end

CreateButton("NO CLIP: ON", function(button)
	Config.NoClip = not Config.NoClip

	if not Config.NoClip then
		RestoreCollisions()
	end

	button.Text = "NO CLIP: " .. (Config.NoClip and "ON" or "OFF")
end)

------------------------------------------------------------
-- SPECTATE + TELEPORT
-- < = previous player, > = next player, big button = teleport to them.
-- The spectate UI disappears (and the menu comes back) after you teleport.
------------------------------------------------------------

local Spectating = false
local SpectateTarget = nil
local SpectateUI = nil
local SpectateLabel = nil

local function GetSpectateList()
	local list = {}

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(list, player)
		end
	end

	-- fixed order so previous / next always go the same way
	table.sort(list, function(a, b)
		return string.lower(a.DisplayName) < string.lower(b.DisplayName)
	end)

	return list
end

-- points the camera at the spectated player's humanoid (re-applied if they respawn)
local function ApplySpectateSubject()
	if not Spectating or not SpectateTarget then
		return
	end

	local cam = workspace.CurrentCamera
	local character = SpectateTarget.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid and cam.CameraSubject ~= humanoid then
		cam.CameraType = Enum.CameraType.Custom
		cam.CameraSubject = humanoid
	end
end

local function SetSpectateTarget(player)
	SpectateTarget = player

	if SpectateLabel then
		SpectateLabel.Text = player and player.DisplayName or "NO PLAYERS"
	end

	ApplySpectateSubject()
end

-- removes ALL spectate UI, gives the camera back to you and brings the menu back
local function StopSpectate()
	Spectating = false
	SpectateTarget = nil

	if SpectateUI then
		SpectateUI:Destroy()
		SpectateUI = nil
		SpectateLabel = nil
	end

	local cam = workspace.CurrentCamera
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		cam.CameraSubject = humanoid
	end

	cam.CameraType = Enum.CameraType.Custom
	Main.Visible = true
end

local function StepSpectate(direction)
	local list = GetSpectateList()

	if #list == 0 then
		StopSpectate()
		return
	end

	local index = table.find(list, SpectateTarget)

	if index then
		index = ((index - 1 + direction) % #list) + 1
	else
		-- current player left: start from the first (or last when going back)
		index = direction > 0 and 1 or #list
	end

	SetSpectateTarget(list[index])
end

local function TeleportToSpectated()
	local target = SpectateTarget
	local targetCharacter = target and target.Character
	local targetRoot = targetCharacter
		and (targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter.PrimaryPart)

	local character = LocalPlayer.Character

	if not targetRoot or not character then
		if SpectateLabel and target then
			SpectateLabel.Text = target.DisplayName .. " (loading...)"
		end

		return
	end

	-- land just behind them, facing the same way
	character:PivotTo(targetRoot.CFrame * CFrame.new(0, 0, 4))

	local root = character:FindFirstChild("HumanoidRootPart")

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end

	StopSpectate()
end

