	local list = GetSpectateList()

	if #list == 0 then
		button.Text = "NO PLAYERS"

		task.delay(2, function()
			button.Text = "SPECTATE"
		end)

		return
	end

	Spectating = true

	-- stop the aim assist from grabbing the camera while spectating
	CurrentTarget = nil
	TargetDot.Visible = false

	Main.Visible = false

	BuildSpectateUI()
	SetSpectateTarget(list[1])
end)

