------------------------------------------------------------
-- SPIN BOT (your character spins very fast for everyone else)
-- Your own camera is not tied to your character's rotation, so in first person you
-- see nothing spin; in third person you can see your character spinning.
------------------------------------------------------------

local SpinOriginalAutoRotate = nil

RunService.Heartbeat:Connect(function()
	if not Config.SpinBot or Spectating then
		return
	end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	-- stop the humanoid from turning you back to face your walking direction
	if SpinOriginalAutoRotate == nil then
		SpinOriginalAutoRotate = humanoid.AutoRotate
	end

	humanoid.AutoRotate = false

	root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
end)

-- first person: hide your own character on YOUR screen only, so you never see it spin
-- (everyone else still sees the real, spinning character)
local SpinHidden = setmetatable({}, { __mode = "k" })

local function RestoreSpinView()
	for part in pairs(SpinHidden) do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end

	table.clear(SpinHidden)
end

