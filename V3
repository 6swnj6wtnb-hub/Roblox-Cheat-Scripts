	Hit.AnchorPoint = Vector2.new(0, 1)
	Hit.Position = UDim2.new(0, 0, 1, 0)
	Hit.Size = UDim2.new(1, 0, 0, 40)
	Hit.BackgroundTransparency = 1
	Hit.Text = ""
	Hit.AutoButtonColor = false
	Hit.ZIndex = 3
	Hit.Parent = Holder

	local function SetAlpha(alpha)
		alpha = math.clamp(alpha, 0, 1)
		Fill.Size = UDim2.new(alpha, 0, 1, 0)
		Knob.Position = UDim2.new(alpha, 0, 0.5, 0)

		local value = math.floor(min + (max - min) * alpha + 0.5)
		Label.Text = format and format(value) or (text .. ": " .. value)
		callback(value)
	end

	local function SetFromX(x)
		local width = math.max(Track.AbsoluteSize.X, 1)
		SetAlpha((x - Track.AbsolutePosition.X) / width)
	end

	local sliding = false

	Hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = true
			Scroll.ScrollingEnabled = false
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement
		) then
			SetFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if sliding and (
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		) then
			sliding = false
			Scroll.ScrollingEnabled = true
		end
	end)

	SetAlpha((default - min) / (max - min))
