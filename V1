local SpeedBase = nil
local SpeedLastSet = nil

RunService.Stepped:Connect(function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		SpeedBase = nil
		SpeedLastSet = nil
		return
	end
	if SpeedLastSet == nil or math.abs(humanoid.WalkSpeed - SpeedLastSet) > 0.01 then
		SpeedBase = humanoid.WalkSpeed
	end
	local multiplier = Config.SpeedBoost and Config.SpeedMultiplier or 1
	local target = SpeedBase
	if multiplier > 1.01 then
		target = math.max(Config.BaseSpeed, SpeedBase) * multiplier
	end
	if math.abs(humanoid.WalkSpeed - target) > 0.01 then
		humanoid.WalkSpeed = target
	end
	SpeedLastSet = humanoid.WalkSpeed
	if multiplier > 1.01 and not Spectating then
		local root = character:FindFirstChild("HumanoidRootPart")
		local move = humanoid.MoveDirection
		if root and move.Magnitude > 0.05 then
			local direction = move.Unit
			local velocity = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(direction.X * target, velocity.Y, direction.Z * target)
		end
	end
end)

