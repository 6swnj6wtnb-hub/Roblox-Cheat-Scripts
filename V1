local SpinOriginalAutoRotate = nil

RunService.Heartbeat:Connect(function()
	if not Config.SpinBot or Spectating then
		return
	end
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if SpinOriginalAutoRotate == nil then
		SpinOriginalAutoRotate = humanoid.AutoRotate
	end
	humanoid.AutoRotate = false
	root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
end)

local SpinHidden = setmetatable({}, { __mode = "k" })

local function RestoreSpinView()
	for part in pairs(SpinHidden) do
		if part.Parent then
			part.LocalTransparencyModifier = 0
		end
	end
	table.clear(SpinHidden)
end

RunService:BindToRenderStep("RGB_SPIN_VIEW", Enum.RenderPriority.Last.Value + 1, function()
	local cam = workspace.CurrentCamera
	local character = LocalPlayer.Character
	local head = character and character:FindFirstChild("Head")
	local firstPerson = head and (cam.CFrame.Position - head.Position).Magnitude < 2
	if Config.SpinBot and not Spectating and firstPerson then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				SpinHidden[part] = true
				part.LocalTransparencyModifier = 1
			end
		end
	elseif next(SpinHidden) ~= nil then
		RestoreSpinView()
	end
end)

local function StopSpin()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and SpinOriginalAutoRotate ~= nil then
		humanoid.AutoRotate = SpinOriginalAutoRotate
	end
	SpinOriginalAutoRotate = nil
	RestoreSpinView()
end

CreateButton("SPIN BOT: OFF", function(button)
