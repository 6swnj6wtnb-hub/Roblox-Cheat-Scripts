-- TARGETING
------------------------------------------------------------

local function GetCharacter(player)
	if not player or player == LocalPlayer then
		return nil
	end
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:FindFirstChildWhichIsA("Humanoid", true)
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character
end

local function IsTeammate(player)
	if not Config.TeamCheck then
		return false
	end
	if LocalPlayer.Team == nil or player.Team == nil then
		return false
	end
	return LocalPlayer.Team == player.Team
end

local ShieldWords = { "shield", "forcefield", "invincib", "godmode", "spawnprotect", "protected" }

local function HasShieldWord(name)
	name = string.lower(tostring(name))
	for _, word in ipairs(ShieldWords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end
	return false
end

local function FlaggedShielded(object)
	if object:IsA("BoolValue") and object.Value and HasShieldWord(object.Name) then
		return true
	end
	for name, value in pairs(object:GetAttributes()) do
		if value == true and HasShieldWord(name) then
			return true
		end
	end
	return false
end

local function IsShielded(character)
	if not Config.ShieldCheck then
		return false
	end
	if character:FindFirstChildOfClass("ForceField") then
		return true
	end
	if FlaggedShielded(character) then
		return true
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and FlaggedShielded(humanoid) then
		return true
	end
	local player = Players:GetPlayerFromCharacter(character)
	if player and FlaggedShielded(player) then
		return true
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("BoolValue") and FlaggedShielded(child) then
			return true
		end
	end
	return false
end

local function IsVisible(character, part)
	if not Config.VisibleCheck then
		return true
	end
	local origin = Camera.CFrame.Position
	local direction = part.Position - origin
	local ignore = { LocalPlayer.Character, character }
	for _, other in ipairs(Players:GetPlayers()) do
		if other.Character then
			table.insert(ignore, other.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.RespectCanCollide = true
	for _ = 1, 6 do
		params.FilterDescendantsInstances = ignore
		local result = workspace:Raycast(origin, direction, params)
		if not result then
			return true
		end
		local hit = result.Instance
		if hit.Transparency >= 0.8 or not hit.CanCollide then
			table.insert(ignore, hit)
		else
			return false
		end
	end
	return false
end

local AimPartCache = setmetatable({}, { __mode = "k" })
local FallbackParts = { "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso" }

local function FindAimPart(character)
	local wanted = character:FindFirstChild(Config.TargetPart, true)
	if wanted and wanted:IsA("BasePart") then
		return wanted
	end
	if string.lower(Config.TargetPart) == "head" then
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart")
				and string.find(string.lower(descendant.Name), "head", 1, true)
				and not descendant:FindFirstAncestorWhichIsA("Accessory")
				and not descendant:FindFirstAncestorWhichIsA("Tool") then
				return descendant
			end
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RootPart then
		return humanoid.RootPart
	end
	for _, name in ipairs(FallbackParts) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part
		end
	end
	if character.PrimaryPart then
		return character.PrimaryPart
	end
	return character:FindFirstChildWhichIsA("BasePart", true)
end

local function GetAimPart(character)
	local cached = AimPartCache[character]
	if cached and cached.Parent and cached:IsDescendantOf(character) then
		return cached
	end
	local part = FindAimPart(character)
	AimPartCache[character] = part
	return part
end

local function IsHeadPart(part)
	return part ~= nil and string.find(string.lower(part.Name), "head", 1, true) ~= nil
end

local function GetFOV()
	local viewport = Camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	return center, Config.FOV
end

local function InsideFOV(worldPosition, holding)
	local center, radius = GetFOV()
	if holding then
		radius = math.huge
	end
	local sp, onScreen = Camera:WorldToViewportPoint(worldPosition)
	if not onScreen then
		return false
	end
	return (Vector2.new(sp.X, sp.Y) - center).Magnitude <= radius
end

local BodyPartNames = { "HumanoidRootPart", "UpperTorso", "Torso" }

local function GetScreenDistance(character, aimPart, center)
	local best = nil
	local function Check(part)
		local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
		if onScreen then
			local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
			if not best or d < best then
				best = d
			end
		end
	end
	Check(aimPart)
	for _, name in ipairs(BodyPartNames) do
		local part = character:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			Check(part)
		end
	end
	return best
end

local function GetBestTarget()
	local center, radius = GetFOV()
	local bestPlayer = nil
	local bestDistance = radius
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and not IsTeammate(player) and not IsBypassed(player) then
			local character = GetCharacter(player)
			if character and not IsShielded(character) then
				local aimPart = GetAimPart(character)
				if aimPart
					and (not Config.HeadOnly or IsHeadPart(aimPart))
					and (Camera.CFrame.Position - aimPart.Position).Magnitude <= Config.MaxDistance then
					local distance = GetScreenDistance(character, aimPart, center)
					if distance and distance <= bestDistance and IsVisible(character, aimPart) then
						bestDistance = distance
						bestPlayer = player
					end
				end
			end
		end
	end
	return bestPlayer
end

local LostTime = nil

local function GetTarget()
	if CurrentTarget and IsBypassed(CurrentTarget) then
		CurrentTarget = nil
		LostTime = nil
	end
	if CurrentTarget and not IsTeammate(CurrentTarget) and not IsBypassed(CurrentTarget) then
		local character = GetCharacter(CurrentTarget)
		if character and not IsShielded(character) then
			local part = GetAimPart(character)
			if part
				and (not Config.HeadOnly or IsHeadPart(part))
				and (Camera.CFrame.Position - part.Position).Magnitude <= Config.MaxDistance
				and InsideFOV(part.Position, true) then
				if not Config.VisibleCheck then
					LostTime = nil
					return CurrentTarget
				end
				if IsVisible(character, part) then
					LostTime = nil
					return CurrentTarget
				end
				LostTime = LostTime or os.clock()
				if os.clock() - LostTime < 0.15 then
					return CurrentTarget
				end
			end
		end
	end
	LostTime = nil
	return GetBestTarget()
end

local VelocityData = setmetatable({}, { __mode = "k" })

local function GetSmoothedVelocity(part)
	local now = os.clock()
	local data = VelocityData[part]
	if not data then
		VelocityData[part] = {
			Position = part.Position,
			Time = now,
			Velocity = Vector3.zero
		}
		return Vector3.zero
	end
	local dt = now - data.Time
	if dt > 0 then
		local raw = (part.Position - data.Position) / dt
		if dt > 0.5 or raw.Magnitude > 150 then
			data.Velocity = Vector3.zero
		else
			local alpha = 1 - math.exp(-dt / 0.2)
			data.Velocity = data.Velocity:Lerp(raw, alpha)
		end
		data.Position = part.Position
		data.Time = now
	end
	return data.Velocity
end

local function GetPredictedPosition(part)
	if not Config.Prediction then
		return part.Position
	end
	local velocity = GetSmoothedVelocity(part)
	velocity = Vector3.new(velocity.X, 0, velocity.Z)
	if velocity.Magnitude < Config.PredictionDeadzone then
		return part.Position
	end
	local lead = velocity * Config.PredictionTime
	local distance = (Camera.CFrame.Position - part.Position).Magnitude
	local maxLead = math.clamp(distance * 0.01, 0.1, Config.MaxLead)
	maxLead = math.min(maxLead, part.Size.Y * 0.5)
	if lead.Magnitude > maxLead then
		lead = lead.Unit * maxLead
	end
	return part.Position + lead
end

local function AimAtTarget(player)
	if not player or IsBypassed(player) then
		return
	end
	local character = GetCharacter(player)
	if not character then
		return
	end
	local part = GetAimPart(character)
	if not part then
		return
	end
	local targetPosition = GetPredictedPosition(part)
	if not InsideFOV(targetPosition, true) then
		TargetDot.Visible = false
		CurrentTarget = nil
		return
	end
	local cameraPosition = Camera.CFrame.Position
	local offset = targetPosition - cameraPosition
	if offset.Magnitude < 0.05 then
		return
	end
	local direction = offset.Unit
	local desiredCFrame = CFrame.lookAt(cameraPosition, cameraPosition + direction)
	local alpha = Config.ForceAim
		and Config.SnapStrength
		or math.clamp(1 - Config.Smoothness, 0, 1)
	if alpha >= 1 then
		Camera.CFrame = desiredCFrame
	else
		Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, alpha)
	end
	local screenPos = Camera:WorldToViewportPoint(targetPosition)
	TargetDot.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
	local distance = (Camera.CFrame.Position - targetPosition).Magnitude
	local dotSize = math.clamp(Config.DotScale / math.max(distance, 1), Config.DotMinSize, Config.DotMaxSize)
	TargetDot.Size = UDim2.fromOffset(dotSize, dotSize)
	TargetDot.Visible = true
end

local LastShot = 0

local function GetWeapon()
	local character = LocalPlayer.Character
	if not character then
		return nil
	end
	for _, object in ipairs(character:GetChildren()) do
		if object:IsA("Tool") then
			return object
		end
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if humanoid and backpack then
		for _, object in ipairs(backpack:GetChildren()) do
			if object:IsA("Tool") then
				humanoid:EquipTool(object)
				return nil
			end
		end
	end
	return nil
end

local function AutoShoot()
	if not Config.AutoShoot then
		SetStatus("AUTO SHOOT: off")
		return
	end
	if not CurrentTarget then
		SetStatus("AUTO SHOOT: no target")
		return
	end
	local character = GetCharacter(CurrentTarget)
	local part = character and GetAimPart(character)
	if not IsHeadPart(part) then
		SetStatus("AUTO SHOOT: no head found on target")
		return
	end
	local viewport = Camera.ViewportSize
	local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
	local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
	if not onScreen or (Vector2.new(sp.X, sp.Y) - center).Magnitude > Config.ShootRadius then
		SetStatus("AUTO SHOOT: lining up on head")
		return
	end
	local tool = GetWeapon()
	if not tool then
		SetStatus("AUTO SHOOT: no weapon equipped")
		return
	end
	if not tool.Enabled then
		SetStatus("AUTO SHOOT: weapon is disabled")
		return
	end
	local now = os.clock()
	if now - LastShot < Config.FireDelay then
		return
	end
	LastShot = now
	SetStatus("AUTO SHOOT: firing at " .. CurrentTarget.DisplayName .. "'s head")
	pcall(function()
		tool:Activate()
	end)
	if Config.ClickFallback then
		pcall(function()
			VirtualUser:Button1Down(center, Camera.CFrame)
			VirtualUser:Button1Up(center, Camera.CFrame)
		end)
	end
	task.defer(function()
		pcall(function()
			tool:Deactivate()
		end)
	end)
end

